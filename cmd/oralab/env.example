# OraLab writes this file with `oralab init`.
# The selected Oracle image lives in compose.yaml, which OraLab never overwrites.
ORACLE_PWD=

# The official Oracle 19c Enterprise defaults used by compose.yaml.
ORACLE_SID=ORCLCDB
ORACLE_PDB=ORCLPDB1

# Created by `oralab init`. To change limits, edit them and run stop/up.
ORACLE_CPUS=
ORACLE_MEMORY=

# Shared memory for Oracle.
ORACLE_SHM_SIZE=

# Docker's graceful-stop period. It does not delete Oracle data.
ORALAB_STOP_GRACE_PERIOD=10m

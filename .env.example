# Copy this file with `oralab setup`, then supply values appropriate to the
# exact official Oracle 19c image selected for this lab.

# Used directly by OraLab through the Docker Engine API.
ORACLE_IMAGE=
ORACLE_PWD=

# Managed by the localhost OraLab Resource Manager. Leave empty until the
# selected image has evidence-based limits, or choose values in `oralab ui`.
ORACLE_CPUS=
ORACLE_MEMORY=

# Shared memory for Oracle. OraLab defaults to 1g when this is empty.
ORACLE_SHM_SIZE=
